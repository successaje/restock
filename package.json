{
  "name": "restock",
  "version": "0.1.0",
  "private": true,
  "description": "An agent that protects solar installers' naira installment income from devaluation: cNGN in, USD₮ restock fund out, supplier paid from a capped Altana wallet.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"PORT=${API_PORT:-8787} tsx watch --clear-screen=false src/server.ts\" \"vite\"",
    "dev:api": "tsx watch src/server.ts",
    "build": "vite build",
    "brand": "tsx scripts/brand/render.ts",
    "screens": "tsx scripts/brand/screens.ts",
    "start": "tsx src/server.ts",
    "agent": "tsx src/agent.ts",
    "status": "tsx scripts/status.ts",
    "rate": "tsx scripts/rate.ts",
    "seed:sample": "tsx scripts/seed-sample.ts",
    "wallet:create": "tsx scripts/create-wallet.ts",
    "grant": "tsx scripts/grant.ts",
    "revoke": "tsx scripts/revoke.ts",
    "agent:setup": "tsx scripts/agent-setup.ts",
    "agent:register": "tsx scripts/register-agent.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "node --test --import tsx 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@altananetwork/sdk": "^1.2.0",
    "@celo/attribution-tags": "^0.5.0",
    "@hono/node-server": "^2.1.11",
    "dotenv": "^18.0.10",
    "hono": "^4.13.22",
    "tsx": "^4.23.15",
    "viem": "^2.58.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.81.0",
    "motion": "^14.14.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "recharts": "^3.11.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "wagmi": "^3.7.11"
  }
}
