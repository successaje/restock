# sim = no keys, no funds, live Textile prices. live = Celo mainnet.
MODE=sim
PORT=8787
# DB_PATH defaults to data/<MODE>.db

# Unlocks the installer dashboard. Required in live mode; anyone who can reach
# the server without it can only see the customer pay page.
# Make one with: openssl rand -base64 24
DASHBOARD_TOKEN=

# Your entry's attribution tag from loops.house (Celo mainnet only counts).
ATTRIBUTION_CODE=celo_test1234
# Optional: lets `npm run status` check the code against codeFromRepo(owner/repo).
GITHUB_REPO=

# ---- the installer's business
INSTALLER_NAME=
RESTOCK_BPS=7000                 # 70% of each installment goes to the restock fund
UNIT_NAME=3.5kVA hybrid kit
UNIT_USD_COST=650                # supplier price per unit, in USD₮
SUPPLIER_NAME=
SUPPLIER_ADDRESS=                # the only address the agent will pay
CASH_ADDRESS=                    # where the cNGN cash share goes (default: the Altana wallet)

# ---- agent wallet (customers pay cNGN here; takes Textile quotes; ERC-8004 identity)
# `npm run agent:setup` generates it if empty.
AGENT_PRIVATE_KEY=
GAS_RESERVE_USDT=0.1
MIN_CONVERT_CNGN=5000            # batch smaller payments until they reach this
POLL_MS=10000
START_BLOCK=                     # first block to scan for payments (default: ~50 blocks back)
AUTO_RESTOCK=false

# ---- Altana restock wallet (the installer's) and the agent's session key
# `npm run wallet:create` and `npm run grant` fill these in.
OWNER_PRIVATE_KEY=               # installer's key: only the owner scripts use it
ALTANA_WALLET=
ALTANA_SESSION_KEY=
ALTANA_SESSION_FILE=data/session.json
ALTANA_SESSION_JSON=             # hosted agents: the line `npm run grant` prints, instead of the file
SESSION_CAP_USDT=2000
SESSION_EXPIRES_AT=              # ISO date; default end of this quarter, Lagos time

# Optional
TEXTILE_API_KEY=
CELO_RPC_URL=https://forno.celo.org
PUBLIC_URL=                      # listed in the ERC-8004 registration if set
AGENT_IMAGE_URL=
